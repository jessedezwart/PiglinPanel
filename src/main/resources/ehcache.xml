<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 https://www.ehcache.org/schema/ehcache-core.xsd">

  <persistence directory="${piglinpanel.cache.dir}"/>

  <cache alias="mod-hashes">
    <key-type>java.lang.String</key-type>
    <value-type>java.lang.String</value-type>
    <resources>
      <heap unit="entries">500</heap>
      <disk unit="MB" persistent="true">10</disk>
    </resources>
  </cache>

  <cache alias="modrinth-projects">
    <key-type>java.lang.String</key-type>
    <value-type>java.util.Map</value-type>
    <expiry>
      <ttl unit="hours">24</ttl>
    </expiry>
    <resources>
      <heap unit="entries">50</heap>
      <disk unit="MB" persistent="true">5</disk>
    </resources>
  </cache>

  <cache alias="mod-updates">
    <key-type>java.lang.String</key-type>
    <value-type>java.util.Map</value-type>
    <expiry>
      <ttl unit="hours">24</ttl>
    </expiry>
    <resources>
      <heap unit="entries">20</heap>
      <disk unit="MB" persistent="true">5</disk>
    </resources>
  </cache>
</config>
